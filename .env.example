# =============================================================================
# Membership Platform API — environment template
#
# Copy to .env and fill in. Every variable the code reads is listed here; the
# only file that touches process.env is src/config/env.js, so this list is
# verifiable with:  grep -o 'process\.env\.[A-Z_]*' src/config/env.js
#
# All values below are PLACEHOLDERS. Never commit a real secret.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated allowed origins. "*" is refused in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# How long shutdown waits for in-flight requests before forcing an exit.
SHUTDOWN_TIMEOUT_MS=10000

# Express "trust proxy". THIS MUST MATCH YOUR ACTUAL TOPOLOGY.
#   <number>  trust that many hops closest to the server (1 = a single nginx,
#             ALB or Cloudflare in front — the default)
#   false     the server is exposed directly; req.ip is the socket address
#   <list>    comma-separated addresses, CIDRs, or Express's named presets
#             (loopback, linklocal, uniquelocal)
#   true      trust every hop — REFUSED in production, because a client can then
#             forge X-Forwarded-For and mint a fresh rate-limit bucket per request
#
# One hop wrong in either direction breaks the auth rate limiter: too low and
# every request arriving through the proxy shares a single bucket, so one busy
# client locks out everyone; too high and the limit is trivially bypassed.
TRUST_PROXY=1

# --- Database ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=membership_app
DB_PASSWORD=replace-with-the-database-password
DB_NAME=membership_platform
DB_CONNECTION_LIMIT=10

# --- JWT ---------------------------------------------------------------------
# REQUIRED in production and must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ISSUER=membership-platform-api
# Member app tokens are long-lived (a phone app); staff tokens are not.
JWT_MEMBER_EXPIRES=7d
JWT_STAFF_EXPIRES=12h

# --- Sessions ----------------------------------------------------------------
# When true, every authenticated request checks auth_sessions so that logout and
# device revocation take effect immediately. Costs one indexed lookup per
# request. Set to false only if you accept that a token stays valid until it
# expires.
ENFORCE_SESSION_REVOCATION=true

# --- Passwords ---------------------------------------------------------------
# Cost factor. Raise as hardware improves; existing hashes keep working and
# needsRehash() reports which ones are behind.
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=10
# Failed attempts before the account refuses to log in until a password reset.
MAX_FAILED_LOGIN_ATTEMPTS=10

# --- Password reset ----------------------------------------------------------
RESET_TOKEN_BYTES=32
RESET_TOKEN_TTL_MINUTES=60

# --- Rate limiting (auth endpoints only) -------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- Approval policy ---------------------------------------------------------
# Which staff role keys may sign off each workflow. Deliberately operator
# configuration rather than tenant-editable data: a tenant administrator can
# edit RBAC rows, and an approval boundary the approver can grant themselves is
# not a boundary. Role keys must exist in the `roles` table for the tenant.
BOOKING_APPROVER_ROLES=owner,administrator,front_desk
PROFILE_CHANGE_APPROVER_ROLES=owner,administrator,membership_officer

# --- Member self-service -----------------------------------------------------
# The only member fields a change request may touch. Anything else submitted is
# dropped, both when the request is created and again when it is approved.
MEMBER_EDITABLE_FIELDS=email,phone,mobile,address_line1,address_line2,city,state,postal_code

# --- Logging -----------------------------------------------------------------
# silent | error | warn | info | debug | trace
LOG_LEVEL=info
# Human-readable single-line output instead of JSON. Development only.
LOG_PRETTY=true

# --- Tests -------------------------------------------------------------------
# Set to 1 to run the integration tests in test/integration, which need a live
# MySQL loaded with database/schema.sql and database/seed_demo.sql. Without it
# those tests are skipped and `npm test` passes with no database.
RUN_DB_TESTS=0

# NODE_TEST_CONTEXT is read by src/config/env.js but is NOT set here: the
# node:test runner sets it in its own workers, and the code uses it only to
# silence logging during `npm test`.
